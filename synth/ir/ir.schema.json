        "generator": {
          "discriminator": {
            "mapping": {
              "categorical": "#/$defs/CategoricalGenerator",
              "copula_ref": "#/$defs/CopulaRefGenerator",
              "date_range": "#/$defs/DateRangeGenerator",
              "derived": "#/$defs/DerivedGenerator",
              "faker": "#/$defs/FakerGenerator",
              "foreign_key": "#/$defs/ForeignKeyGenerator",
              "numeric": "#/$defs/NumericGenerator",
              "sequence": "#/$defs/SequenceGenerator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FakerGenerator"
            },
            {
              "$ref": "#/$defs/CategoricalGenerator"
            },
            {
              "$ref": "#/$defs/NumericGenerator"
            },
            {
              "$ref": "#/$defs/SequenceGenerator"
            },
            {
              "$ref": "#/$defs/DateRangeGenerator"
            },
            {
              "$ref": "#/$defs/CopulaRefGenerator"
            },
            {
              "$ref": "#/$defs/DerivedGenerator"
            },
            {
              "$ref": "#/$defs/ForeignKeyGenerator"
            }
          ],
          "title": "Generator"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "null_rate": {
          "default": 0,
          "maximum": 0.5,
          "minimum": 0,
          "title": "Null Rate",
          "type": "number"
        },
        "outlier_rate": {
          "default": 0,
          "maximum": 0.1,
          "minimum": 0,
          "title": "Outlier Rate",
          "type": "number"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "pk": {
          "default": false,
          "title": "Pk",
          "type": "boolean"
        },
        "constraints": {
